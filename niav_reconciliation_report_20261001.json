  "decisions": [
    {
      "ids": [
        "D-09",
        "O-03",
        "O-M03"
      ],
      "status": "Decided: proposed value",
      "effective": "From New Bill to Pay & Finish (cash): <=10 s and <=10 touch interactions; scripted harness + 3 volunteer timings; fixture TD-PERF-01 (5,000 items, 500 parties, 20,000 vouchers)"
    },
    {
      "ids": [
        "O-M03"
      ],
      "status": "Decided: proposed value",
      "effective": "p95 <=200 ms keystroke-to-results on 5,000-item fixture (Android 12-13); <=400 ms on reference low-end device"
    },
    {
      "ids": [
        "O-M04"
      ],
      "status": "Decided: proposed value",
      "effective": "minSdk 26. Reference low-end: Android 8-9, 2 GB RAM, 32 GB storage. Cold start <=5 s; quick bill <=15 s; core report on 20,000 vouchers <=5 s; APK <=40 MB per ABI"
    },
    {
      "ids": [
        "D-05",
        "D-R5"
      ],
      "status": "Decided: proposed value",
      "effective": "Accepted: Android-only V1"
    },
    {
      "ids": [
        "D-07"
      ],
      "status": "Decided: proposed value",
      "effective": "V1 stays Rs0; server / Play Store / e-invoice provider reviewed only at V2 after revenue"
    },
    {
      "ids": [
        "D-M2",
        "D-M3",
        "O-M05"
      ],
      "status": "Decided: proposed value",
      "effective": "R1a (Simple, single device) then R1b (Advanced, multi-device); if S2/S3 slip, R1b ships with file merge, LAN sync as R1b.1"
    },
    {
      "ids": [
        "O-M01",
        "O-M02"
      ],
      "status": "Decided: proposed value",
      "effective": "Schedule stays 'week N from T0'; velocity re-baselined after WP-00/01"
    },
    {
      "ids": [
        "D-R7"
      ],
      "status": "Decided: proposed value",
      "effective": "P1/P2/P3 govern phasing; features may slip to R2 if a gate fails"
    },
    {
      "ids": [
        "O-14"
      ],
      "status": "Decided: proposed value",
      "effective": "Local-only storage; minimal data collection; no telemetry; Indian data-protection obligations to be checked"
    },
    {
      "ids": [
        "D-M5",
        "D-08",
        "D-FG-013",
        "O-09",
        "OD-004",
        "OD-FD-001"
      ],
      "status": "Decided: proposed value",
      "effective": "(1) Methods: Weighted Average and FIFO only. (2) Item overrides group; default Weighted Average. (3) Method locked after first posted stock movement; no change in V1. (4) Negative stock allowed with warning; no-layer issues costed at last known cost; no retro revaluation in V1. (5) Period lock by date; unlock needs right + reason + audit. (6) Orders never reserve stock (D-M6 = No). (7) Golden ledgers: opening, purchase, sale, returns, adjustment, negative-stock sale, lock/unlock"
    },
    {
      "ids": [
        "D-M4",
        "OD-DB-001"
      ],
      "status": "Decided: proposed value",
      "effective": "Money INTEGER paise. Quantity INTEGER x10^4 (per-unit display precision: pcs 0, kg/litre 3, other <=4). Line amount = round-half-up(qty x rate / 10^4); invoice round-off separate ledger line to nearest rupee. Stock value in paise; unit cost derived. IDs UUIDv7 TEXT. Dates ISO TEXT; timestamps INTEGER epoch ms UTC"
    },
    {
      "ids": [
        "OD-001",
        "O-08"
      ],
      "status": "Decided: owner value",
      "effective": "Invoice will have limited series, as CA advice on keeping number of invoice series to be minimum"
    },
    {
      "ids": [
        "OD-003"
      ],
      "status": "Rejected: explicit owner instruction",
      "effective": "Rejected — FRD OD-003 is withdrawn; no requirement is admitted under this ID."
    },
    {
      "ids": [
        "O-FG-005"
      ],
      "status": "Decided: proposed value",
      "effective": "Auto-match only if amount exact (0 paise) AND reference unique; otherwise suggestions with date window +/-3 days (cheques +/-7); user always confirms; CSV/XLSX first, PDF later"
    },
    {
      "ids": [
        "D-04",
        "O-05",
        "D-FG-014"
      ],
      "status": "Decided: proposed value",
      "effective": "10-day grace with full function + daily reminder, then read-only + export + backup; data never deleted; entitlements.json (edition x term x trial x grace x limits) is single source for gates and tests"
    },
    {
      "ids": [
        "D-11",
        "D-13",
        "A-R2"
      ],
      "status": "Decided: proposed value",
      "effective": "Trial 3 months, full feature set of installed release (R1a = Simple features; R1b+ = Advanced). On trial end buying Simple keeps Advanced data read-only/exportable"
    },
    {
      "ids": [
        "D-10",
        "O-06",
        "O-15",
        "OD-007"
      ],
      "status": "Decided: proposed value",
      "effective": "Simple (R1a): masters, P1 dual+accounting vouchers, Delivery Note, Stock Transfer/Journal, basic quotation/order, Quick Bill, search, core reports, GST reports, Excel import/export, backup, en/hi/gu, 1 device. Advanced (R1b+): all Simple + multi-user/roles, approvals, document-flow automation, Material Issue/Receive, batch/expiry, price lists, multi-godown reports, LAN/hotspot + file sync, audit/admin tools"
    },
    {
      "ids": [
        "O-15",
        "OD-007"
      ],
      "status": "Decided: owner value",
      "effective": "Advanced: up to 5 devices and 10 users per company; Simple: 1 device, up to 3 users. S3 only tests 3 devices: certify 5 until larger fleet tested."
    },
    {
      "ids": [
        "D-14"
      ],
      "status": "Decided: proposed value",
      "effective": "Prepaid keys carrying an expiry date (1/3/6/12 months or lifetime); no monthly re-issue"
    },
    {
      "ids": [
        "D-15",
        "D-R2",
        "O-04"
      ],
      "status": "Decided: owner value",
      "effective": "yes V1.x patches count as upgrades"
    },
    {
      "ids": [
        "D-12"
      ],
      "status": "Pending",
      "effective": "Single APK with runtime edition gating"
    },
    {
      "ids": [
        "D-16"
      ],
      "status": "Decided: proposed value",
      "effective": "Optional and opportunistic: used only to detect clock rollback when online; never required"
    },
    {
      "ids": [
        "D-FG-012"
      ],
      "status": "Decided: owner value",
      "effective": "reissue limit - 20"
    },
    {
      "ids": [
        "D-06",
        "OD-DB-001"
      ],
      "status": "Decided: proposed value",
      "effective": "Whole-DB encryption with SQLCipher-class engine (AES-256); random 256-bit key wrapped by Android Keystore; PIN/biometric gates key use; final library chosen in G0 spike"
    },
    {
      "ids": [
        "OD-DB-004"
      ],
      "status": "Decided: proposed value",
      "effective": "Field-level old/new deltas as JSON; sensitive fields hash-only; hash chain over canonical record"
    },
    {
      "ids": [
        "OD-DB-005",
        "O-FG-015"
